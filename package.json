{
  "name": "sabertaz.github.io",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "pnpm lint:style && pnpm lint:type-check",
    "lint:style": "eslint . && stylelint ./src/**/*.css",
    "lint:type-check": "tsc --noEmit",
    "lint:fix": "eslint . --fix && stylelint ./src/**/*.css --fix",
    "changeset": "commit-and-tag-version --dry-run -s",
    "release": "commit-and-tag-version -s"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.16.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@dg-scripts/eslint-config": "^6.3.0",
    "@dg-scripts/stylelint-config": "^6.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "commit-and-tag-version": "^13.5.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^18.1.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
